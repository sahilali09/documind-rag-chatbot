# Copy this file to .env and set only the values required for your setup.

LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

LLM_TEMPERATURE=0.2

EMBEDDING_PROVIDER=huggingface

HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

CHUNK_SIZE=1000
CHUNK_OVERLAP=150

CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=rag_chatbot
INDEX_VERSION=1

RETRIEVER_K=4
MAX_HISTORY_TURNS=6

# Set blank to disable retrieval abstention.
RETRIEVAL_SCORE_THRESHOLD=0.2

MAX_UPLOAD_SIZE_MB=20
MAX_UPLOAD_FILES=10

ENABLE_RETRIEVAL_DIAGNOSTICS=false